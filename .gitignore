# Figures and metrics written by osk.outputs — regenerable from a run
output/

# Kerchunk references: regenerable, and they store absolute paths to local model
# output, so they are meaningless in anyone else's clone
refs/
docs/refs/

# Project-local scratch: catalogs a user builds against their own model output
# (build_catalog(refs, "catalogs/<name>.yaml") writes here). The package's own
# reference catalogs ship inside ocean_skill/catalogs/ instead — see its README.
catalogs/

# Notebook scratch: divergent copies of catalogs/, shadows them from docs/
docs/catalogs/
